// G1-G6 修复端到端验证: 二进制IO + Vec.set/remove/insert + struct字段赋值 + now_ms
struct Point {
    x: i32,
    y: i32,
}

fn main() {
    // G4: struct 字段赋值
    var p = Point { x: 1, y: 2 }
    p.x = 99
    p.y = p.x + 1
    print(f"point: {p.x} {p.y}")

    // G2: Vec.set / insert / remove
    var v: Vec<i32> = []
    v.push(10)
    v.push(20)
    v.push(30)
    v.set(1, 55)
    v.insert(0, 7)
    v.remove(3)
    var i = 0
    while i < v.len() {
        print(f"v[{i}] = {v.get(i)}")
        i = i + 1
    }

    // G1: 二进制 IO 往返
    let bytes = to_bytes(42)
    write_bytes("g_gap.bin", bytes)
    let back = read_bytes("g_gap.bin")
    print(f"bytes len: {back.len()}")
    let s = bytes_to_string(base64_encode(back))
    print(f"b64: {s}")

    // now_ms: 64位毫秒时间戳
    let ms = now_ms()
    print(f"now_ms > 0: {ms > 0}")
    print("OK")
}
