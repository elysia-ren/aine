fn add(x: i32, y: i32) -> i32 {
    return x + y
}

fn mul(x: i32, y: i32) -> i32 {
    return x * y
}

fn get_op(fast: bool) -> fn(i32, i32) -> i32 {
    if fast {
        return add
    }
    return mul
}

fn main() {
    let op = get_op(true)
    print(op(20, 2))
    print(get_op(false)(20, 2))
}
