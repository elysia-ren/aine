// ┌─ 诊断质量验收（里程碑 A · 1.1）
// │  每条错误：位置准确 + 白话解释 + 具体建议
// └─────────────────────────────────────
fn add(a: i32, b: i32) -> i32 {
    return a + b
}

fn main() {
    let n: i32 = "hello"          // ① 类型不匹配 + 建议
    print(add(1))                 // ② 参数个数 + 参数清单
    print(add(1, "x"))            // ③ 参数类型 + 转换提示
    print(adsd)         // ④ 拼写相近 → did-you-mean
    if 123 {
        print("x")                // ⑤ 条件非 bool + 解释
    }
}
