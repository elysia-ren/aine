// Aine Studio v0 — 纯 Aine 自绘 IDE（D2D rt_* 运行时 + Scintilla 编辑器）
// 布局与 mockup 一致：顶栏 / rail / 左栏 / 编辑器 / Assistant / Problems / 状态栏
// S1e-3c: Problems/Symbols/状态栏接真实编译器输出（tokenize → parse_program_safe
//         → tck_program，rpc() 直调语义：编译器前端模块内嵌进程）

struct Seg {
    text: String
    col: i32
    wd: i32
    md: i32
}

struct Diag {
    code: String
    msg: String
    line: i32
    sev: i32
}

// TokKind/Token 本地定义（枚举变体不过模块边界; 与 alinterp/compiler_service 同惯例）
enum TokKind {
    TIdent
    TInt
    TFloat
    TStr
    TOp
    TSemi
    TEof
}

struct Token {
    kind: TokKind
    text: String
}

enum Expr {
    EInt(i32)
    EFloat(f64)
    EStr(String)
    EIdent(String)
    EBin(String, Expr, Expr)
    EUnary(String, Expr)
    ECall(Expr, Vec<Expr>)
    EField(Expr, String)
    EBlock(Vec<Stmt>)
    EVec(Vec<Expr>)
    EUnit
    EStruct(String, Vec<StructField>)
    ETry(Expr)
    ERange(Expr, Expr)
    EClosure(Vec<Param>, Expr)
    EIndex(Expr, Expr)
    EIf(Expr, Vec<Stmt>, Vec<Stmt>)
    EMatch(Expr, Vec<MatchArm>)
}

enum Stmt {
    SLet(String, bool, Option<String>, Expr)
    SIf(Expr, Vec<Stmt>, Vec<Stmt>)
    SWhile(Expr, Vec<Stmt>)
    SFor(String, Expr, Vec<Stmt>)
    SReturn(Option<Expr>)
    SExpr(Expr)
    SBlock(Vec<Stmt>)
    SAssign(String, String, Expr)
    SAssignIdx(String, Expr, String, Expr)
    SDef(String, Vec<Param>, Option<String>, Vec<Stmt>)
    SStruct(String, Vec<Field>)
    SEnum(String, Vec<EVariant>)
    SImpl(String, Vec<Stmt>)
    SMod(String, Vec<Stmt>)
    SImport(String)
    SMatch(Expr, Vec<MatchArm>)
    SGo(bool, Vec<Stmt>)
    SUi(Vec<Stmt>)
    SGlobalVar(String, Option<String>, Expr)
}

struct MatchArm {
    pat: String
    body: Stmt
}

struct Field {
    name: String
    ty: String
}

struct StructField {
    name: String
    value: Expr
}

struct EVariant {
    name: String
    fields: Vec<String>
}

struct Param {
    name: String
    ty: String
}

struct EPResult {
    value: Expr
    next: i32
}

struct SPResult {
    stmt: Stmt
    next: i32
}

struct BlockResult {
    stmts: Vec<Stmt>
    next: i32
}

struct TyResult {
    ty: String
    next: i32
}

struct FlatResult {
    out: Vec<Stmt>
    loaded: Vec<String>
}

struct VarInfo {
    names: Vec<String>
    types: Vec<String>
}

// UI/表面语言状态 (S0.6): 0=zh-CN 1=en 2=ja 3=de 4=fr 5=ru
@global var g_lang: i32 = 0
@global var g_langmenu: bool = false
@global var g_status: String = "就绪"
@global var g_orig: String = ""

// ---------- 主题（mockup CSS，0xRRGGBB） ----------
fn c_paper() -> i32 { return 16513783 }
fn c_paper2() -> i32 { return 16184559 }
fn c_ink() -> i32 { return 2434335 }
fn c_sub() -> i32 { return 7829103 }
fn c_faint() -> i32 { return 10855323 }
fn c_line() -> i32 { return 14671317 }
fn c_green() -> i32 { return 4351323 }
fn c_green2() -> i32 { return 15133929 }
fn c_rail() -> i32 { return 15658214 }
fn c_white() -> i32 { return 16777215 }
fn c_kw() -> i32 { return 7035767 }
fn c_ty() -> i32 { return 4352093 }
fn c_str() -> i32 { return 9854010 }
fn c_num() -> i32 { return 10580035 }
fn c_ln() -> i32 { return 12039338 }
fn c_sel() -> i32 { return 15133929 }
fn c_curbg() -> i32 { return 16316403 }
fn c_red() -> i32 { return 3292360 }

// ---------- 语法高亮 ----------
fn is_word_char(ch: char) -> bool {
    (ch >= "a" && ch <= "z") || (ch >= "A" && ch <= "Z") || (ch >= "0" && ch <= "9") || ch == "_"
}

fn is_kw(w: String) -> bool {
    if w == "fn" || w == "let" || w == "mut" || w == "if" || w == "else" || w == "while" || w == "for" || w == "in" || w == "match" || w == "return" || w == "break" || w == "continue" || w == "use" || w == "module" || w == "struct" || w == "enum" || w == "type" || w == "impl" || w == "true" || w == "false" || w == "None" || w == "Some" || w == "Ok" || w == "Err" || w == "as" || w == "pub" {
        return true
    }
    return false
}

fn tok_color(tok: String, mode: i32) -> i32 {
    if mode == 3 { return c_ln() }
    if mode == 2 { return c_str() }
    if mode == 1 {
        if is_kw(tok) { return c_kw() }
        let c0 = tok[0]
        if c0 >= "A" && c0 <= "Z" { return c_ty() }
        if c0 >= "0" && c0 <= "9" { return c_num() }
        return c_ink()
    }
    return c_ink()
}

// mode: 0 标点 1 单词 2 字符串 3 注释
fn line_segments(line: String) -> Vec<Seg> {
    var segs: Vec<Seg> = []
    let n = line.len()
    var i = 0
    var mode = 0
    var tok_start = 0
    while i < n {
        let ch = line[i]
        var nm = mode
        if mode == 2 {
            nm = 2
            if ch == "\"" { nm = 0 }
        } else if mode == 3 {
            nm = 3
        } else if ch == "\"" {
            nm = 2
        } else if ch == "/" && i + 1 < n {
            if line[i + 1] == "/" { nm = 3 }
        } else if is_word_char(ch) {
            nm = 1
        } else {
            nm = 0
        }
        if nm != mode {
            var end = i
            if mode == 2 && ch == "\"" { end = i + 1 }
            if end > tok_start {
                let tok = line[tok_start..end]
                segs.push(Seg { text: tok, col: tok_color(tok, mode), wd: tok.len(), md: mode })
            }
            tok_start = i
            if mode == 2 && ch == "\"" { tok_start = i + 1 }
            mode = nm
        }
        i += 1
    }
    if n > tok_start {
        let tok = line[tok_start..n]
        segs.push(Seg { text: tok, col: tok_color(tok, mode), wd: tok.len(), md: mode })
    }
    return segs
}

fn ends_with(s: String, suf: String) -> bool {
    let sl = s.len()
    let fl = suf.len()
    if fl > sl { return false }
    return s[sl - fl..sl] == suf
}

fn int_to_str(v: i32) -> String {
    if v == 0 { return "0" }
    var n: i32 = v
    var out = ""
    while n > 0 {
        let d = n - (n / 10) * 10
        let digits = "0123456789"
        out = out + digits[d..d + 1]
        n = n / 10
    }
    // 反转
    var rev = ""
    var i = out.len() - 1
    while i >= 0 {
        rev = rev + out[i..i + 1]
        i -= 1
    }
    return rev
}

fn clip_to(s: String, mx: i32) -> String {
    if s.len() <= mx { return s }
    var out = ""
    var k: i32 = 0
    while k < mx {
        out = out + s[k..k + 1]
        k += 1
    }
    return out
}

// ---------- 真实诊断：tokenize → parse_program_safe → tck_program ----------
fn tok_line(toks: Vec<Token>, index: i32) -> i32 {
    // PErr.index 是 token 下标；换行在词法层是 TSemi("\n")，数它得到行号
    var ln: i32 = 1
    var j: i32 = 0
    let n: i32 = toks.len()
    while j < index && j < n {
        let tk: Token = toks[j]
        if tk.kind == TSemi && tk.text == "\n" {
            ln += 1
        }
        j += 1
    }
    return ln
}

fn compute_diags(content: String) -> Vec<Diag> {
    var out: Vec<Diag> = []
    let toks: Vec<Token> = tokenize(content)
    let psr: SafeParse = parse_program_safe(toks)
    let en: i32 = psr.errors.len()
    var i: i32 = 0
    while i < en {
        let pe: PErr = psr.errors[i]
        let ln: i32 = tok_line(toks, pe.index)
        out.push(Diag { code: "E0001", msg: pe.message, line: ln, sev: 0 })
        i += 1
        if i >= 60 {
            return out
        }
    }
    if en == 0 {
        let tdiags: Vec<String> = tck_program(psr.stmts)
        var k: i32 = 0
        let tn: i32 = tdiags.len()
        while k < tn && k < 60 {
            out.push(Diag { code: "W0401", msg: tdiags[k], line: 0, sev: 1 })
            k += 1
        }
    }
    return out
}

fn compute_symbols(content: String) -> Vec<String> {
    var out: Vec<String> = []
    let toks: Vec<Token> = tokenize(content)
    let psr: SafeParse = parse_program_safe(toks)
    if psr.errors.len() > 0 {
        return out
    }
    out = collect_fn_names(psr.stmts)
    return out
}

fn compute_types(content: String) -> Vec<String> {
    var out: Vec<String> = []
    let toks: Vec<Token> = tokenize(content)
    let psr: SafeParse = parse_program_safe(toks)
    if psr.errors.len() > 0 {
        return out
    }
    out = collect_user_types(psr.stmts)
    return out
}

// ---------- 快速指南 (Docs 菜单) ----------
fn doc_text() -> String {
    var d = "# Aine Studio\n"
    d = d + "\n"
    d = d + "左栏: 项目文件树, 点击打开/切换 (切换前自动保存)"
    d = d + "\n"
    d = d + "编辑器: Scintilla, 直接输入, Aine 语法着色"
    d = d + "\n"
    d = d + "问题面板: 真实编译器诊断, 点击行跳转"
    d = d + "\n"
    d = d + "符号面板: 当前文件的函数与类型"
    d = d + "\n"
    d = d + "\n"
    d = d + "菜单:"
    d = d + "\n"
    d = d + "  运行 - 编译当前文件成 exe 并启动"
    d = d + "\n"
    d = d + "  测试 - 工作区全部 .aine 文件解析扫描"
    d = d + "\n"
    d = d + "  文档 - 打开本指南"
    d = d + "\n"
    d = d + "  右上语言按钮 - 切换表面: 中文/EN/日本語/Deutsch/Français/Русский"
    d = d + "\n"
    d = d + "\n"
    d = d + "试试 examples/zh_demo.aine: 纯中文语法, 运行按钮直接构建启动。"
    return d
}

