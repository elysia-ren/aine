        m.push("in")
        v.push("返す")
        m.push("return")
        v.push("真")
        m.push("true")
        v.push("偽")
        m.push("false")
        v.push("構造")
        m.push("struct")
        v.push("列挙")
        m.push("enum")
        v.push("使う")
        m.push("use")
        v.push("表示")
        m.push("print")
        v.push("中断")
        m.push("break")
        v.push("継続")
        m.push("continue")
        v.push("マッチ")
        m.push("match")
    }
    if idx == 3 {
        code = "de"
        name = "Deutsch"
        v.push("Funktion")
        m.push("fn")
        v.push("wenn")
        m.push("if")
        v.push("sonst")
        m.push("else")
        v.push("solange")
        m.push("while")
        v.push("für")
        m.push("for")
        v.push("in")
        m.push("in")
        v.push("zurück")
        m.push("return")
        v.push("wahr")
        m.push("true")
        v.push("falsch")
        m.push("false")
        v.push("Struktur")
        m.push("struct")
        v.push("Aufzählung")
        m.push("enum")
        v.push("benutzen")
        m.push("use")
        v.push("drucken")
        m.push("print")
        v.push("abbrechen")
        m.push("break")
        v.push("weiter")
