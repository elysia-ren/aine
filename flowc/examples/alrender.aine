// alrender.aine — Language Rendering (S0.6, Language Veil)
// 一门语义 (Canonical Aine), 多种人类语言表面。
// Profile 为声明式数据: 新增语言 = 往 profile_get 加一张词表, 引擎零改动。
// 约定: 逐 token 替换、不跨行、不碰字符串/注释 → 行号/列不变, 诊断坐标直通。


struct LangProfile {
    code: String
    name: String
    words: Vec<String>
    maps: Vec<String>
    ops_from: Vec<String>
    ops_to: Vec<String>
}

fn profile_count() -> i32 {
    return 6
}

// idx: 0=zh-CN 1=en(canonical 恒等) 2=ja 3=de 4=fr 5=ru
