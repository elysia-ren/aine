    return LangProfile { code: code, name: name, words: v, maps: m, ops_from: of, ops_to: ot }
}

fn lang_name(idx: i32) -> String {
    let p: LangProfile = profile_get(idx)
    return p.name
}

fn lang_code(idx: i32) -> String {
    let p: LangProfile = profile_get(idx)
    return p.code
}

// 查表: w 在 from 中的下标 → to 同下标项; 未命中原样返回
fn map_run(w: String, from: Vec<String>, to: Vec<String>) -> String {
    let n: i32 = from.len()
    var i: i32 = 0
    while i < n {
        if from[i] == w {
            return to[i]
        }
        i += 1
    }
    return w
}

// 词元是否终止一个 run
fn is_run_end(c: char) -> bool {
    if c == " " || c == "\t" || c == "\r" || c == "\n" {
        return true
    }
    let stops = "{}()[]<>=+-*/!&|%,:;.?\"#@"
    for s in stops {
        if s == c {
            return true
        }
    }
    return false
}

// 双向变换: to_canonical=true 表面→canonical; false canonical→表面
fn prof_transform(text: String, idx: i32, to_canonical: bool) -> String {
    let prof: LangProfile = profile_get(idx)
    var out = ""
    let n: i32 = text.len()
    var i: i32 = 0
    var mode: i32 = 0
    while i < n {
        let c = text[i]
        if mode == 0 {
            if c == "\"" {
                mode = 1
                out = out + c
                i += 1
                continue
            }
            if c == "/" && i + 1 < n {
                if text[i + 1] == "/" {
                    mode = 2
                    out = out + "//"
                    i += 2
                    continue
                }
            }
            if is_run_end(c) {
                // canonical → 表面时, ASCII 运算符是终止字符不形成 run, 在此探测映射
                if to_canonical == false {
                    var mapped = ""
                    var step: i32 = 0
                    if i + 1 < n {
                        let arrow = text[i..i + 2]
                        if arrow == "->" {
                            out = out + "->"
                            i += 2
                            continue
                        }
                        let two = text[i..i + 2]
                        var k: i32 = 0
                        let om: i32 = prof.ops_from.len()
                        while k < om {
                            if prof.ops_to[k] == two {
                                mapped = prof.ops_from[k]
                                step = 2
                            }
                            k += 1
                        }
                    }
                    if step == 0 {
                        let one = text[i..i + 1]
                        var k2: i32 = 0
                        let om2: i32 = prof.ops_from.len()
                        while k2 < om2 {
                            if prof.ops_to[k2] == one {
                                mapped = prof.ops_from[k2]
                                step = 1
                            }
                            k2 += 1
                        }
                    }
                    if step > 0 {
                        out = out + mapped
                        i += step
                        continue
                    }
                }
                out = out + c
                i += 1
                continue
            }
            // 收集一个完整 run
            var j: i32 = i
            while j < n {
                if is_run_end(text[j]) {
                    break
                }
                j += 1
            }
            let run = text[i..j]
            // 单次映射: 先查关键字表, 未命中再查运算符表
            var mapped = run
            if to_canonical {
                mapped = map_run(run, prof.words, prof.maps)
                if mapped == run {
                    mapped = map_run(run, prof.ops_from, prof.ops_to)
                }
            } else {
                mapped = map_run(run, prof.maps, prof.words)
                if mapped == run {
                    mapped = map_run(run, prof.ops_to, prof.ops_from)
                }
            }
            out = out + mapped
            i = j
            continue
        }
        if mode == 1 {
            if c == "\"" {
                mode = 0
            }
            out = out + c
            i += 1
            continue
        }
        // mode == 2 注释
        if c == "\n" {
            mode = 0
        }
        out = out + c
        i += 1
    }
    return out
}

// 表面 → canonical (源码进入编译器前调用; en 恒等)
fn surface_to_canonical_p(text: String, idx: i32) -> String {
    if idx == 1 {
        return text
    }
    return prof_transform(text, idx, true)
}

// canonical → 表面 (切换显示语言; en 恒等)
fn render_to(text: String, idx: i32) -> String {
    if idx == 1 {
        return text
    }
    return prof_transform(text, idx, false)
}

// 该语言是否含此关键字/运算符 (着色用)
fn lang_has_kw(idx: i32, w: String) -> bool {
    if idx == 1 {
        return false
    }
    let p: LangProfile = profile_get(idx)
    let n: i32 = p.words.len()
    var i: i32 = 0
    while i < n {
        if p.words[i] == w {
            return true
        }
        i += 1
    }
    let m: i32 = p.ops_from.len()
    var j: i32 = 0
    while j < m {
        if p.ops_from[j] == w {
            return true
        }
        j += 1
    }
    return false
}
