fn main() -> Result<(), String> {
    let t = true
    print("T=" + f"{t}")
    if t {
        print("IF-TRUE")
    } else {
        print("IF-FALSE")
    }
    var k = 0
    while true {
        print("LOOP " + f"{k}")
        k += 1
        if k >= 2 {
            break
        }
    }
    print("AFTER-WHILE")
    return Ok(())
}
