fn main() {
    var src = "fn fib(n: i32) -> i32 {\n    if n < 2 {\n        return n\n    }\n    return fib(n - 1) + fib(n - 2)\n}\nfn main() {\n    print(fib(10))\n}"
    print("len=" + f"{src.len()}")
    let len = src.len()
    var i = 0
    while i < len {
        let c = src[i..i + 1]
        if c == "\n" {
            print("NL i=" + f"{i}")
            i += 1
            continue
        }
        print("C[" + c + "] i=" + f"{i}")
        i += 1
    }
    print("DONE i=" + f"{i}")
}
