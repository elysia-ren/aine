// M23 测试框架 —— 故意包含失败用例，演示失败报告与退出码
// 运行: aine test examples/testfail.aine
// 预期: this_one_passes 通过；wrong_sum_fails 因返回 Err 失败；
//       runtime_error_is_caught 因越界运行时错误失败。退出码非 0。

fn expect(cond: bool, msg: String) -> Result<i32, String> {
    if cond {
        return Ok(0)
    }
    return Err(msg)
}

@test
fn this_one_passes() -> Result<i32, String> {
    return expect(2 + 2 == 4, "算术坏了")
}

@test
fn assert_failure_demo() -> Result<i32, String> {
    // assert 失败 = 运行时错误 = 测试失败（框架捕获后报告原因）
    assert(1 == 2, "这条断言必须失败")
    return Ok(0)
}

@test
fn wrong_sum_fails() -> Result<i32, String> {
    return expect(1 + 1 == 3, "1+1 竟然不等于 3")
}

@test
fn runtime_error_is_caught() -> Result<i32, String> {
    let v = [1, 2, 3]
    let x = v[10]
    return expect(x == 3, "不会到这里")
}
