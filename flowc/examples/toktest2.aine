enum TokKind {
    TIdent
    TInt
    TFloat
    TStr
    TOp
    TSemi
    TEof
}

struct Token {
    kind: TokKind
    text: String
}

module allex;
module alparse;

fn main() {
    let files = ["altype.aine", "altypeck.aine", "alvalueal.aine", "allex.aine", "alparse.aine", "alstr.aine", "alcollect.aine", "alee.aine"]
    for f in files {
        let src = read_file("examples/" + f)
        let toks = tokenize(src)
        let ps = parse_program(toks)?
        print("DONE " + f + " toks=" + f"{toks.len()}")
    }
}
