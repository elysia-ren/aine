// counter.aine — Aine 图形化 exe (S1e: 自绘运行时 + @global + ui{})
// 构建: aine build examples/counter.aine
// 运行: counter.exe → 自绘窗口 "Aine Counter"(mockup 主题), 点 "+1" 计数

@global var count: i32 = 0
@global var lbl: i32 = 0

fn on_click() {
    count = count + 1
    rt_set_comp_text(lbl, "count: " + f"{count}")
}

fn main() {
    ui {
        Window("Aine Counter", 320, 200) {
            Panel(0, 0, 304, 160, "paper")
            Text(20, 20, 220, 26, "count: 0", "ink", "lbl")
            Button(20, 60, 96, 30, "+1", "on_click")
        }
    }
}
