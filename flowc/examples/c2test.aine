module altype;
module altypeck;
module alvalueal;
module allex;
module alparse;
module alstr;
module alcollect;
module alee;

enum TokKind {
    TIdent
    TInt
    TFloat
    TStr
    TOp
    TSemi
    TEof
}

struct Token {
    kind: TokKind
    text: String
}

fn main() {
    let src1 = "fn fib(n: i32) -> i32 {\n    if n < 2 {\n        return n\n    }\n    return fib(n - 1) + fib(n - 2)\n}\nfn main() {\n    print(fib(10))\n}"
    let p1 = parse_program(tokenize(src1))?
    print("STEP parse")
    let ut = collect_user_types(p1)
    print("STEP ut")
    let vn = collect_variant_names(p1)
    print("STEP vn")
    let vo = collect_variant_owners(p1)
    print("STEP vo")
    let fn_ = collect_fn_names(p1)
    print("STEP fn")
    let fr = collect_fn_returns(p1)
    print("STEP fr")
    let va = collect_var_names(p1)
    print("STEP va")
    let vt = collect_var_types(p1)
    print("STEP vt")
    let fp = collect_fn_ptypes(p1)
    print("STEP fp")
    let et = collect_enum_ty_names(p1)
    print("STEP et")
    let el = collect_enum_variant_lists(p1)
    print("STEP el")
    let c1 = c_program(p1, ut, vn, vo, fn_, fr, va, vt, fp, et, el)
    print("STEP cprog len=" + f"{c1.len()}")
}
