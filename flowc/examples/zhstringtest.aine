// 中文字符串语义验证（⑥ 字符索引模型）—— 解释器路径
fn reverse(s: String) -> String {
    var out = ""
    var i = s.len() - 1
    while i >= 0 {
        out = out + s[i..i + 1]
        i -= 1
    }
    return out
}

fn main() {
    let zh = "你好Flow"
    print(zh.len())
    print(zh[0])
    print(zh[2])
    print(reverse(zh))
    print(zh[0..2])
    assert(zh.len() == 6, "字符数应为 6")
    assert(zh[0] == "你", "首字符应为 你")
    assert(reverse(zh) == "wolF好你", "反转应为 wolF好你")
    print("zh OK")
}
