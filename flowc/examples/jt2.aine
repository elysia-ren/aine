// std/json 端到端：mod 搜索路径读入 stdlib/json.aine
module json;

fn main() {
    let q = "\""
    let src = "{" + q + "name" + q + ": " + q + "Aine" + q + ", " + q + "version" + q + ": 1.5}"
    let r = parse_value(src, 0)?
    let text = stringify(r.value)
    print(text)
    let r2 = parse_value(text, 0)?
    let text2 = stringify(r2.value)
    if text == text2 {
        print("json OK")
    }
}
