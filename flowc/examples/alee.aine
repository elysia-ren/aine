    out = out + "#define al_some_s(x) ((al_opt){ .tag = 1, .data.s = (x) })\n"
    out = out + "#define al_some_v(x) ((al_opt){ .tag = 1, .data.v = (x) })\n"
    out = out + "#define al_some_p(x) ((al_opt){ .tag = 1, .data.p = (void*)(x) })\n"
    for t in user_types {
        out = out + "#define al_some_t_" + t + "(x) ((al_opt){ .tag = 1, .data.t_" + t + " = al_dup(&(x), sizeof(x)) })\n"
    }
    out = out + "#define al_none() ((al_opt){ .tag = 0 })\n"
    // 枚举变体字段表（嵌套模式解析用）
    let vfnames = collect_enum_variant_names(program)
    let vftypes = collect_enum_variant_ftypes(program)
    // 结构体字段表（EField 推断用）
    let snames = collect_struct_snames(program)
    let sfnames = collect_struct_fnames(program)
    let sftypes = collect_struct_ftypes(program)
    // 函数作用域变量表
    let fn_names_all = collect_fn_names(program)
    let fn_var_infos = collect_fn_var_infos(program)
    let fptypes = collect_fn_ptypes(program)
    let enames = collect_enum_ty_names(program)
    let elists = collect_enum_variant_lists(program)
    // 用户类型定义

    // 全局变量(S1c): 类型定义后、函数前发射 C 文件作用域变量
    for s in program {
        match s {
            SGlobalVar(name, ty, init) {
                let ct = c_type(ty, user_types)
                let ic = c_expr(init, user_types, vnames, vowners, varnames, vartypes, snames, sfnames, sftypes, fnames, freturns, fptypes, enames, elists)
                out = out + ct + " " + name + " = " + ic + ";\n"
            }
            _ {}
        }
    }
    for s in program {
        match s {
            SStruct(n, f) { out = out + c_stmt(s, "", user_types, vnames, vowners, fnames, freturns, varnames, vartypes, "", vfnames, vftypes, snames, sfnames, sftypes, fn_names_all, fn_var_infos, fptypes, enames, elists, false) + "\n" }
            SEnum(n, v) { out = out + c_stmt(s, "", user_types, vnames, vowners, fnames, freturns, varnames, vartypes, "", vfnames, vftypes, snames, sfnames, sftypes, fn_names_all, fn_var_infos, fptypes, enames, elists, false) + "\n" }
            _ {}
        }
    }

    // 函数前向声明（互递归）
    for s in program {
        match s {
            SDef(fname, params, ret, body_s) {
                var ps: Vec<String> = []
                for p in params { ps.push(c_param_decl(p.ty, p.name, user_types)) }
                var ct = "void"
                match ret {
                    Some(rr) { ct = c_type(Some(rr), user_types) }
                    None {
                        if fname == "main" { ct = "int" } else { ct = "void" }
                    }
                }
                if fname == "main" { ct = "int" }
                if fname == "main" {
                    out = out + "int main(int _argc, char** _argv);\n"
                } else {
                    out = out + ct + " " + fname + "(" + join(ps, ", ") + ");\n"
                }
            }
            SImpl(ty, methods) {
                // impl 方法前向声明：Type_method(struct Type self, ...)
                for m in methods {
                    match m {
                        SDef(fname, params, ret, _) {
                            var ps: Vec<String> = []
                            for p in params {
                                if p.ty == "self" {
                                    ps.push(c_param_decl(ty, p.name, user_types))
                                } else {
                                    ps.push(c_param_decl(p.ty, p.name, user_types))
                                }
                            }
                            var mct = "void"
                            match ret {
                                Some(rr) { mct = c_type(Some(rr), user_types) }
                                None {}
                            }
                            out = out + mct + " " + ty + "_" + fname + "(" + join(ps, ", ") + ");\n"
                        }
                        _ {}
                    }
                }
            }
            _ {}
        }
    }
    // 函数定义（struct/enum 已在前面输出）

    for s in program {
        match s {
            SStruct(n, f) {}
            SEnum(n, v) {}
            SDef(bn, _, _, _) {
                // 值流内建：header 已有 C 内建实现，跳过 Aine 体
                if bn != "al_strcat_own" && bn != "al_strdup_lit" && bn != "write_file" && bn != "append_file" && bn != "file_exists" {
                    var def_has_body = false
                    match s {
                        SDef(_, _, _, body_s) {
                            if body_s.len() > 0 { def_has_body = true }
                        }
                        _ {}
                    }
                    // extern 声明（空体）→ 仅保留前向声明，不发射函数体（符号由外部 C 提供）
                    if def_has_body {
                        out = out + c_stmt(s, "", user_types, vnames, vowners, fnames, freturns, varnames, vartypes, "", vfnames, vftypes, snames, sfnames, sftypes, fn_names_all, fn_var_infos, fptypes, enames, elists, false) + "\n"
                    }
                }
            }
            SImpl(ty, methods) {
                // impl 方法发射：Type_method(struct Type self, ...) —— self 形参替换为 impl 类型
                for m in methods {
                    match m {
                        SDef(name, params, ret, body_s) {
                            var ps2: Vec<Param> = []
                            for p in params {
                                if p.ty == "self" {
                                    ps2.push(Param { name: p.name ty: ty })
                                } else {
                                    ps2.push(p)
                                }
                            }
                            let s2 = SDef(ty + "_" + name, ps2, ret, body_s)
                            out = out + c_stmt(s2, "", user_types, vnames, vowners, fnames, freturns, varnames, vartypes, "", vfnames, vftypes, snames, sfnames, sftypes, fn_names_all, fn_var_infos, fptypes, enames, elists, false) + "\n"
                        }
                        _ {}
                    }
                }
            }
            SExpr(unit_e) {
                // interface 声明等占位节点（EUnit）→ 不发射
                match unit_e {
                    EUnit {}
                    _ { out = out + c_stmt(s, "", user_types, vnames, vowners, fnames, freturns, varnames, vartypes, "", vfnames, vftypes, snames, sfnames, sftypes, fn_names_all, fn_var_infos, fptypes, enames, elists, false) + "\n" }
                }
            }
            _ { out = out + c_stmt(s, "", user_types, vnames, vowners, fnames, freturns, varnames, vartypes, "", vfnames, vftypes, snames, sfnames, sftypes, fn_names_all, fn_var_infos, fptypes, enames, elists, false) + "\n" }
        }
    }

    return out
}
