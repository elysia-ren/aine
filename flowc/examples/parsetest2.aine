enum TokKind {
    TIdent
    TInt
    TFloat
    TStr
    TOp
    TSemi
    TEof
}

struct Token {
    kind: TokKind
    text: String
}

enum Expr {
    EInt(i32)
    EFloat(f64)
    EStr(String)
    EIdent(String)
    EBin(String, Expr, Expr)
    EUnary(String, Expr)
    ECall(Expr, Vec<Expr>)
    EField(Expr, String)
    EBlock(Vec<Stmt>)
    EVec(Vec<Expr>)
    EUnit
    EStruct(String, Vec<StructField>)
    ETry(Expr)
    ERange(Expr, Expr)
    EClosure(Vec<Param>, Expr)
    EIndex(Expr, Expr)
    EIf(Expr, Vec<Stmt>, Vec<Stmt>)
    EMatch(Expr, Vec<MatchArm>)
}

enum Stmt {
    SLet(String, bool, Option<String>, Expr)
    SIf(Expr, Vec<Stmt>, Vec<Stmt>)
    SWhile(Expr, Vec<Stmt>)
    SFor(String, Expr, Vec<Stmt>)
    SReturn(Option<Expr>)
    SExpr(Expr)
    SBlock(Vec<Stmt>)
    SAssign(String, String, Expr)
    SAssignIdx(String, Expr, String, Expr)
    SDef(String, Vec<Param>, Option<String>, Vec<Stmt>)
    SStruct(String, Vec<Field>)
    SEnum(String, Vec<EVariant>)
    SImpl(String, Vec<Stmt>)
    SMod(String, Vec<Stmt>)
    SImport(String)
    SMatch(Expr, Vec<MatchArm>)
    SGo(bool, Vec<Stmt>)
    SUi(Vec<Stmt>)
    SGlobalVar(String, Option<String>, Expr)
}

struct MatchArm {
    pat: String
    body: Stmt
}

struct Field {
    name: String
    ty: String
}

struct StructField {
    name: String
    value: Expr
}

struct EVariant {
    name: String
    fields: Vec<String>
}

struct Param {
    name: String
    ty: String
}

struct EPResult {
    value: Expr
    next: i32
}

struct SPResult {
    stmt: Stmt
    next: i32
}

struct BlockResult {
    stmts: Vec<Stmt>
    next: i32
}

struct TyResult {
    ty: String
    next: i32
}

struct FlatResult {
    out: Vec<Stmt>
    loaded: Vec<String>
}

struct VarInfo {
    names: Vec<String>
    types: Vec<String>
}

module allex;
module alparse;
module alstr;
module alcollect;
module altype;

fn main() {
    let src = read_file("examples/transpiler.aine")
    print("STEP src " + f"{src.len()}")
    let toks = tokenize(src)
    print("STEP toks " + f"{toks.len()}")
    let ps = parse_program(toks)?
    print("STEP parsed " + f"{ps.len()}")
}
