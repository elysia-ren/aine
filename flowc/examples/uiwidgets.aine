// uiwidgets.aine — S1b 控件扩充验收: Input + Listbox
// 构建: aine build examples/uiwidgets.aine
// 运行: 输入文字点 "Add" 进入列表; 列表点选 + "Selected" 读取选中项

@global var entry: i32 = 0
@global var list: i32 = 0

fn on_add() {
    let t: String = get_text(entry)
    if t.len() > 0 {
        listbox_add(list, t)
        set_text(entry, "")
    }
}

fn on_show() {
    let sel: i32 = listbox_selected(list)
    if sel >= 0 {
        // P0: 选中项序号回显到输入框
        set_text(entry, "selected: " + f"{sel}")
    }
}

fn main() {
    ui {
        Window("Aine Widgets", 320, 340) {
            Text("Aine widgets demo")
            Input("type here...", "entry")
            Button("Add", "on_add")
            List("list")
            Button("Selected", "on_show")
        }
    }
}
