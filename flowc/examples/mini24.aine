// 自举拆分：类型工具在 altype.aine（文件模块，扁平注册）


// parser_stmt.aine — 用 Aine 写的语句级解析器（自举 B4-M2）
// 在 parser_expr.aine 的 Pratt 表达式核心之上，扩展：
//   语句：let(mut/类型注解)/if-else/while/for..in/return/赋值/块/表达式语句
//   项：fn 定义（参数、返回类型）
// 输出完整 AST 的 stringify 回显，main 内自断言。

enum TokKind {
    TIdent
    TInt
    TFloat
    TStr
    TOp
    TSemi
    TEof
}

struct Token {
    kind: TokKind
    text: String
}

enum Expr {
    EInt(i32)
    EFloat(f64)
    EStr(String)
    EIdent(String)
    EBin(String, Expr, Expr)
    EUnary(String, Expr)
    ECall(Expr, Vec<Expr>)
    EField(Expr, String)
    EBlock(Vec<Stmt>)
    EVec(Vec<Expr>)
    EUnit
    EStruct(String, Vec<StructField>)
    ETry(Expr)
    ERange(Expr, Expr)
    EClosure(Vec<Param>, Expr)
    EIndex(Expr, Expr)
    EIf(Expr, Vec<Stmt>, Vec<Stmt>)
    EMatch(Expr, Vec<MatchArm>)
}

enum Stmt {
    SLet(String, bool, Option<String>, Expr)
    SIf(Expr, Vec<Stmt>, Vec<Stmt>)
    SWhile(Expr, Vec<Stmt>)
    SFor(String, Expr, Vec<Stmt>)
    SReturn(Option<Expr>)
    SExpr(Expr)
    SBlock(Vec<Stmt>)
    SAssign(String, String, Expr)
    SAssignIdx(String, Expr, String, Expr)
    SDef(String, Vec<Param>, Option<String>, Vec<Stmt>)
    SStruct(String, Vec<Field>)
    SEnum(String, Vec<EVariant>)
    SImpl(String, Vec<Stmt>)
    SMod(String, Vec<Stmt>)
    SImport(String)
    SMatch(Expr, Vec<MatchArm>)
    SGo(bool, Vec<Stmt>)
    SUi(Vec<Stmt>)
    SGlobalVar(String, Option<String>, Expr)
}

struct MatchArm {
    pat: String
    body: Stmt
}

struct Field {
    name: String
    ty: String
}

struct StructField {
    name: String
    value: Expr
}

struct EVariant {
    name: String
    fields: Vec<String>
}

struct Param {
    name: String
    ty: String
}

struct EPResult {
    value: Expr
    next: i32
}

struct SPResult {
    stmt: Stmt
    next: i32
}

struct BlockResult {
    stmts: Vec<Stmt>
    next: i32
}

struct TyResult {
    ty: String
    next: i32
}

struct FlatResult {
    out: Vec<Stmt>
    loaded: Vec<String>
}

// var name -> type tables
struct VarInfo {
    names: Vec<String>
    types: Vec<String>
}

module altype;
module altypeck;
module alvalueal;
module allex;
module alparse;
module alstr;
module alcollect;
module alee;
fn main() -> Result<(), String> {
    let src24 = "fn helper() -> String {\n    return \"abc\"\n}\nfn main() {\n    let s = helper()\n    print(s)\n    var v: Vec<i32> = []\n    print(f\"{v.len()}\")\n    let p = \"abcdef\"\n    print(f\"{p[4..p.len()]}\")\n}"
    let p24 = parse_program(tokenize(src24))?
    let c24 = c_program(p24, collect_user_types(p24), collect_variant_names(p24), collect_variant_owners(p24), collect_fn_names(p24), collect_fn_returns(p24), collect_var_names(p24), collect_var_types(p24), collect_fn_ptypes(p24), collect_enum_ty_names(p24), collect_enum_variant_lists(p24))
    print("FNNAMES " + join(collect_fn_names(p24), ","))
    print("FNRETS " + join(collect_fn_returns(p24), ","))
    print("VARNAMES " + join(collect_var_names(p24), ","))
    print("VARTYPES " + join(collect_var_types(p24), ","))
    print("VT-s " + f"{var_type(\"s\", collect_var_names(p24), collect_var_types(p24))}")
    print("VT-v " + f"{var_type(\"v\", collect_var_names(p24), collect_var_types(p24))}")
    print("FR " + f"{fn_return(\"helper\", collect_fn_names(p24), collect_fn_returns(p24))}")
    print("MR " + f"{method_ret(\"len\", 0)}")
    let vn2 = collect_var_names(p24)
    let vt2 = collect_var_types(p24)
    let fn2 = collect_fn_names(p24)
    let fr2 = collect_fn_returns(p24)
    let ect = expr_ctype(ECall(EField(EIdent("v"), "len"), []), vn2, vt2, fn2, fr2, [], [], [], [])
    print("ECT " + ect)
    let bst = base_type(EIdent("v"), vn2, vt2, fn2, fr2, [], [], [])
    print("BT " + f"{bst}")
    for st in p24 {
        match st {
            SDef(nm2, pr2, rt2, bd2) {
                print("STMT " + nm2)
                for st2 in bd2 {
                    print("  " + f"{st2}")
                }
            }
            _ {}
        }
    }
    print(c24)
    return Ok(())
}
