// awen-proto/src/lexer.aine —— 词法编排:逐行分类 + Raw Block / 表格状态机
// (核心规范 §6、§9、§11)。移植自 Rust 版 lexer/mod.rs。
//
// ⚠ Aine 解释器限制:match 臂内的 continue/break 不生效(见 docs/PORT_NOTES.md),
//   因此主循环采用"先自增行号"结构,所有 continue 都位于 while 顶层的 if 内。

// ── 块级结构 ───────────────────────────────────────────────

enum Block {
    Blank
    Heading(i32, Vec<Inline>)
    Paragraph(Vec<Inline>)
    ListItem(bool, Vec<Inline>)
    Quote(i32, Vec<Inline>)
    Divider
    // 整行只有一个显式命令(图片、目录、文档级设置、行内注释等)
    Object(CommandUse)
    RawOpen(ExplicitCommand, Option<String>)
    // Raw Block 内容行,逐字保留(§6.7)
    RawLine(String)
    RawClose(ExplicitCommand)
    TableOpen(CommandUse)
    TableRow(Vec<Vec<Inline>>, bool)
    TableClose
}

struct LexedBlock {
    // 0 起算行号
    line: i32
    block: Block
}

struct LexOutput {
    blocks: Vec<LexedBlock>
    diags: Vec<Diagnostic>
}

// 命令行处理结果(值语义:状态整体返回,由 lex 循环写回)
struct CmdOutcome {
    blocks: Vec<LexedBlock>
    diags: Vec<Diagnostic>
    raw: Option<ExplicitCommand>
    table: bool
}

// CRLF 兼容:剥离行尾 '\r'(字符串方法只有 trim,无 trim_end)
fn lex_strip_cr(line: String) -> String {
    if line.len() > 0 && line[line.len() - 1] == "\r" {
        return line[0..line.len() - 1]
    }
    return line
}

// 行内容若恰为关闭标签,返回其中的命令名
fn lex_close_tag_name(line: String) -> Option<String> {
    let t = line.trim()
    if starts_with_at(t, 0, "@[/") {
        if t.len() >= 4 && t[t.len() - 1] == "]" {
            return Some(t[3..t.len() - 1])
        }
    }
    return None
}

// 分隔行单元格:仅由 '-' 与可选的 ':' 构成,至少含一个 '-'(§9.1 对齐标记)
fn lex_is_delimiter_cell(c: String) -> bool {
    var has_dash = false
    var k = 0
    while k < c.len() {
        let ch = c[k]
        if ch == "-" {
            has_dash = true
        } else if ch != ":" {
            return false
        }
        k += 1
    }
    return has_dash
}

// ── 词法入口 ───────────────────────────────────────────────

fn lex(src: String) -> LexOutput {
    var blocks: Vec<LexedBlock> = []
    var diags: Vec<Diagnostic> = []
    var raw: Option<ExplicitCommand> = None
    var table = false

    let lines = src.split("\n")
    var lineno = 0
    // 行号先行自增:后续所有 continue 都在 while 顶层的 if 内(规避 match 臂限制)
    while lineno < lines.len() {
        let line = lex_strip_cr(lines[lineno])
        lineno += 1

        // Raw Block 状态:内容行逐字保留,直到匹配的关闭标签行
        let in_raw = match raw {
            Some(cmd) { true }
            None { false }
        }
        if in_raw {
            let cmd = match raw {
                Some(c) { c }
                None { Code }
            }
            let close_opt = lex_close_tag_name(line)
            var closed = false
            match close_opt {
                Some(name) {
                    if close_matches(cmd, name) {
                        closed = true
                    }
                }
                None { }
            }
            if closed {
                blocks = blocks.push(LexedBlock { line: lineno - 1, block: RawClose(cmd) })
                raw = None
            } else {
                blocks = blocks.push(LexedBlock { line: lineno - 1, block: RawLine(line) })
            }
            continue
        }

        // 表格状态
        if table {
            let t = line.trim()
            if t == "@[/table]" {
                blocks = blocks.push(LexedBlock { line: lineno - 1, block: TableClose })
                table = false
                continue
            }
            if t.len() == 0 {
                blocks = blocks.push(LexedBlock { line: lineno - 1, block: Blank })
                continue
            }
            if starts_with_at(t, 0, "|") && t[t.len() - 1] == "|" && t.len() >= 2 {
                let inner = t[1..t.len() - 1]
                var cells_text: Vec<String> = []
                var cur = ""
                for ch in inner {
                    if ch == "|" {
                        cells_text = cells_text.push(cur.trim())
                        cur = ""
                    } else {
                        cur = cur + ch
                    }
                }
                cells_text = cells_text.push(cur.trim())
                var all_delim = true
                for ct in cells_text {
                    if !lex_is_delimiter_cell(ct) {
                        all_delim = false
                    }
                }
                var cells: Vec<Vec<Inline>> = []
                for ct in cells_text {
                    let so = lw_scan_inline(ct, lineno - 1, diags)
                    diags = so.diags
                    cells = cells.push(so.inline)
                }
                blocks = blocks.push(LexedBlock {
                    line: lineno - 1,
                    block: TableRow(cells, all_delim),
                })
                continue
            }
            diags = diags.push(diag_error("表格块内只能包含表格行(以 | 开始和结束)或 @[/table]", lineno - 1))
            blocks = blocks.push(LexedBlock {
                line: lineno - 1,
                block: Paragraph([AwTxt(line)]),
            })
            continue
        }

        // 常规行分类
        let cls = classify(line)
        match cls {
            LcBlank {
                blocks = blocks.push(LexedBlock { line: lineno - 1, block: Blank })
            }
            LcDivider {
                blocks = blocks.push(LexedBlock { line: lineno - 1, block: Divider })
            }
            LcHeading(level) {
                let so = lw_scan_inline(line[level + 1..line.len()], lineno - 1, diags)
                diags = so.diags
                blocks = blocks.push(LexedBlock { line: lineno - 1, block: Heading(level, so.inline) })
            }
            LcQuote(depth) {
                let so = lw_scan_inline(line[depth + 1..line.len()], lineno - 1, diags)
                diags = so.diags
                blocks = blocks.push(LexedBlock { line: lineno - 1, block: Quote(depth, so.inline) })
            }
            LcListItem(ordered) {
                let skip = if ordered { ordered_marker_len(line) } else { 2 }
                let so = lw_scan_inline(line[skip..line.len()], lineno - 1, diags)
                diags = so.diags
                blocks = blocks.push(LexedBlock { line: lineno - 1, block: ListItem(ordered, so.inline) })
            }
            LcCommand {
                let co = lex_command_line(line, lineno - 1, diags, raw, table)
                for nb in co.blocks {
                    blocks = blocks.push(nb)
                }
                diags = co.diags
                raw = co.raw
                table = co.table
            }
            LcText {
                let so = lw_scan_inline(line, lineno - 1, diags)
                diags = so.diags
                blocks = blocks.push(LexedBlock { line: lineno - 1, block: Paragraph(so.inline) })
            }
        }
    }

    let last = lines.len()
    match raw {
        Some(cmd) { diags = diags.push(diag_error("Raw Block 未闭合到文件结尾", last)) }
        None { }
    }
    if table {
        diags = diags.push(diag_error("@[table] 未闭合到文件结尾", last))
    }
    return LexOutput { blocks: blocks, diags: diags }
}

// 顶格 `@[` 命令行:Raw 开启 / 表格开启 / 独立对象 / 段落。
// 整行必然被消费(值语义返回全部状态,循环层只管行号)。
fn lex_command_line(
    chars: String,
    lineno: i32,
    diags: Vec<Diagnostic>,
    raw: Option<ExplicitCommand>,
    table: bool,
) -> CmdOutcome {
    var blocks: Vec<LexedBlock> = []
    var diags = diags
    let hp = parse_header(chars, 0)
    match hp {
        Err(e) => {
            var mut_d = diag_error(e.msg, lineno)
            match e.hint {
                Some(h) { mut_d = diag_hint(mut_d, h) }
                None { }
            }
            diags = diags.push(mut_d)
            blocks = blocks.push(LexedBlock {
                line: lineno,
                block: Paragraph([AwTxt(chars)]),
            })
            return CmdOutcome { blocks: blocks, diags: diags, raw: raw, table: table }
        }
        Ok(hp2) => {
            let u = hp2.cu
            let consumed = hp2.consumed
            if u.cmd == Table {
                blocks = blocks.push(LexedBlock { line: lineno, block: TableOpen(u) })
                return CmdOutcome { blocks: blocks, diags: diags, raw: raw, table: true }
            }
            if is_raw_block(u.cmd) {
                // Raw 块开启条件:头部无内容(comment 行内形式有内容)且行尾为空;
                // 否则走行内路径(@[m]…@[/m] 同行闭合、@[comment 内容] 独立对象)
                let header_empty = match u.content {
                    None { true }
                    Some(c) { c.len() == 0 }
                }
                let rest = chars[consumed..chars.len()]
                if header_empty && rest.trim().len() == 0 {
                    var lang: Option<String> = None
                    if u.cmd == Code && u.args.len() > 0 {
                        lang = Some(arg_plain(u.args[0]))
                    }
                    blocks = blocks.push(LexedBlock {
                        line: lineno,
                        block: RawOpen(u.cmd, lang),
                    })
                    return CmdOutcome { blocks: blocks, diags: diags, raw: Some(u.cmd), table: table }
                }
            }
            // 整行行内扫描;若整行恰为单个命令 → 独立对象
            let so = lw_scan_inline(chars, lineno, diags)
            var is_single = false
            var single: Option<CommandUse> = None
            if so.inline.len() == 1 {
                match so.inline[0] {
                    Command(cu) {
                        is_single = true
                        single = Some(cu)
                    }
                    _ { }
                }
            }
            // unwrap() 在 Aine 中不可靠(返回 Nil),改用 match
            // (Aine bug: Option.unwrap() 对所有类型返回 Nil)
            match single {
                Some(cu) {
                    blocks = blocks.push(LexedBlock {
                        line: lineno,
                        block: Object(cu),
                    })
                }
                None {
                    // is_single=true 但 unwrap 失败 → 走 Paragraph 回退
                    blocks = blocks.push(LexedBlock { line: lineno, block: Paragraph(so.inline) })
                }
            }
            return CmdOutcome { blocks: blocks, diags: diags, raw: raw, table: table }
        }
    }
}
